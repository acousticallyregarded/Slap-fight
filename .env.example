# Provider keys below can also be typed into Admin -> API keys instead of this file
# (stored in server/data/secrets.json; a key saved there wins over this file).
# Buy vs. Sell server environment. Copy to .env (never commit real values).
PORT=8787
# Where progress, settings and idempotency state are stored.
DATA_DIR=./server/data
# Required for the admin screen and demo controls. Viewers never need it.
ADMIN_PASSWORD=change-me
# Set to false only for local http development (cookie is Secure by default).
COOKIE_SECURE=true

# --- Confirmed swaps --------------------------------------------------------
# Free option (recommended): Trades = "Solana chain" on the admin screen reads
# pump.fun's own trade records from the chain through SOLANA_RPC_URL below.
# A free Helius account's RPC link works, e.g.
#   https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Its WebSocket is the same link with wss://; set SOLANA_WS_URL only if yours differs.
SOLANA_WS_URL=
# Helius enhanced webhook + history backfill (https://www.helius.dev/docs)
HELIUS_API_KEY=
# Any long random string; configure the same value as the webhook's authHeader.
HELIUS_WEBHOOK_AUTH=
HELIUS_BASE_URL=https://mainnet.helius-rpc.com
# Or PumpPortal (third-party trade stream, paid per event)
PUMPPORTAL_API_KEY=
# Solana JSON-RPC endpoint: reads trades (Solana chain option) and confirms every swap.
SOLANA_RPC_URL=

# --- SOL/USD at trade time -------------------------------------------------
# Pyth Benchmarks (official historical prices). Take the SOL/USD feed id from
# Pyth's price-feed-ids list.
PYTH_API_KEY=
PYTH_SOL_USD_FEED_ID=
# Jupiter Price API v3 (live samples; optional key raises the rate limit)
JUPITER_API_KEY=

# --- Market cap ------------------------------------------------------------
# Not needed for the free options: "From each trade" (with Trades = Solana chain)
# or DexScreener (no key). Birdeye only:
BIRDEYE_API_KEY=

# --- Chat -----------------------------------------------------------------
# pump.fun has no official chat API. Two options, chosen on the admin screen:
# - "Unofficial reader: pump-chat-client" reads the token's pump.fun chat with
#   no key needed (read-only; may break if pump.fun changes its site).
# - A relay you operate, which must sign each POST to /api/chat/relay with
#   HMAC-SHA256(body, CHAT_RELAY_SECRET).
CHAT_RELAY_SECRET=
